<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="36dp"
    android:paddingBottom="6dp">

    <!-- AI Sparkle Avatar -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_circle_icon"
        android:backgroundTint="@color/chat_ai_avatar_bg"
        android:gravity="center">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Trợ lý Âm nhạc"
            android:src="@drawable/ic_assistant_wave"
            app:tint="@color/spotify_green" />
    </LinearLayout>

    <!-- Message Content Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Bubble -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_ai"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvAiMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Embedded Songs RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAiSongs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- Nút tạo Playlist bằng AI từ danh sách bài hát này -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreatePlaylistFromAi"
                style="@style/Widget.Spotify.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="✨ Tạo Playlist từ danh sách này"
                android:textColor="@color/on_primary_accent"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_playlist_add"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/on_primary_accent"
                app:cornerRadius="22dp"
                android:visibility="gone" />

            <!-- Follow-up suggestion chips -->
            <HorizontalScrollView
                android:id="@+id/hsvSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFollowUps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true" />
            </HorizontalScrollView>

        </LinearLayout>

        <TextView
            android:id="@+id/tvAiTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
