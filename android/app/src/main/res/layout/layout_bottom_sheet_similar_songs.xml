<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_24dp">

    <!-- BottomSheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_12dp"
        android:layout_marginBottom="@dimen/spacing_12dp"
        android:background="@drawable/bg_pill_indicator"
        android:backgroundTint="@color/text_disabled" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_20dp"
        android:paddingEnd="@dimen/spacing_20dp"
        android:paddingBottom="@dimen/spacing_8dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_assistant_wave"
            app:tint="@color/spotify_green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bài hát tương tự (Song Radio)"
                android:textAppearance="@style/TextAppearance.Spotify.Headline"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSimilarTargetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Spotify.Caption"
                android:textColor="@color/text_secondary"
                tools:text="Dựa trên đặc trưng âm nhạc của bài hát" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayAllSimilar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/spotify_green"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Phát tất cả"
            android:textAllCaps="false"
            android:textColor="@color/on_primary_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_play_arrow"
            app:iconPadding="4dp"
            app:iconSize="16dp"
            app:iconTint="@color/on_primary_accent" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/spacing_8dp"
        android:background="@color/divider_color" />

    <ProgressBar
        android:id="@+id/pbSimilarLoading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:indeterminateTint="@color/spotify_green"
        android:visibility="visible" />

    <TextView
        android:id="@+id/tvSimilarEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="Không tìm thấy bài hát tương tự phù hợp."
        android:textAppearance="@style/TextAppearance.Spotify.Body"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!-- Similar Tracks RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSimilarTracks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:maxHeight="460dp"
        android:overScrollMode="never"
        android:visibility="gone" />

</LinearLayout>
