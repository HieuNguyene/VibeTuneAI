<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/spotify_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- BottomSheet Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_indicator" />

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Tạo danh sách phát mới"
                android:textAppearance="@style/TextAppearance.Spotify.Headline"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseSheet"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary" />
        </RelativeLayout>

        <!-- Mode Selector: Manual vs AI -->
        <LinearLayout
            android:id="@+id/layoutModeSelector"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_selection_button_group"
            android:orientation="horizontal"
            android:padding="3dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeManual"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@color/selection_active_bg"
                android:text="Thủ công"
                android:textColor="@color/selection_active_text"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/selection_active_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeAi"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@android:color/transparent"
                android:text="Tạo bằng AI ✨"
                android:textColor="@color/selection_inactive_text"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_assistant_wave"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/selection_inactive_text" />
        </LinearLayout>

        <!-- AI Creation Mode Section -->
        <LinearLayout
            android:id="@+id/layoutAiSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <!-- AI Header Promo Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_creator_readonly"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="6dp"
                        android:src="@drawable/ic_assistant_wave"
                        app:tint="@color/spotify_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Sáng tạo playlist bằng AI"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Mô tả tâm trạng, hoàn cảnh, ca sĩ hoặc thể loại. AI sẽ tự động phân tích và tuyển chọn 15 bài hát phù hợp nhất vào playlist của bạn."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- AI Prompt Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAiPrompt"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Chủ đề hoặc tâm trạng playlist *"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/input_box_bg"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/spotify_green"
                app:counterEnabled="true"
                app:counterMaxLength="200"
                app:counterTextColor="@color/text_secondary"
                app:hintTextColor="@color/spotify_green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAiPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="200"
                    android:minLines="3"
                    android:maxLines="4"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Suggestion Chips Scroll -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Gợi ý chủ đề nhanh:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupAiSuggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAiSad"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌧️ Nhạc buồn suy ban đêm"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/spotify_elevated" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAiChill"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☕ Acoustic cafe nhẹ nhàng"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/spotify_elevated" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAiWorkout"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 Tập gym &amp; chạy bộ sung sức"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/spotify_elevated" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAiVpop"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎵 Hit V-Pop thịnh hành"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/spotify_elevated" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Manual Creation Section Container -->
        <LinearLayout
            android:id="@+id/layoutManualSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Cover Image Picker Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <FrameLayout
                android:id="@+id/btnPickCoverImage"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_cover_picker_placeholder"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Selected Cover Image Preview -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPlaylistCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Spotify.Card" />

                <!-- Upload Placeholder Icon and Text -->
                <LinearLayout
                    android:id="@+id/layoutUploadPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/spotify_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Chọn ảnh bìa từ máy"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="(Chạm để mở tệp)"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Change Photo Overlay Badge -->
                <LinearLayout
                    android:id="@+id/layoutChangeBadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#99000000"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Đổi ảnh"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvCoverHelper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ảnh bìa sẽ được tải và lưu trữ trên hệ thống"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Creator Field (Người tạo - Read Only) -->
        <LinearLayout
            android:id="@+id/layoutCreatorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_creator_readonly"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/ivCreatorAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="6dp"
                android:src="@drawable/ic_person"
                app:tint="@color/spotify_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Người tạo playlist"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCreatorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Nguyen Van A" />
            </LinearLayout>

            <!-- Locked Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_inactive"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Cố định"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Playlist Title Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPlaylistTitle"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Tên danh sách phát *"
            android:textColorHint="@color/text_secondary"
            app:boxBackgroundColor="@color/input_box_bg"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/spotify_green"
            app:counterEnabled="true"
            app:counterMaxLength="100"
            app:counterTextColor="@color/text_secondary"
            app:hintTextColor="@color/spotify_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlaylistTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Playlist Description Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPlaylistDescription"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:hint="Mô tả danh sách phát (tùy chọn)"
            android:textColorHint="@color/text_secondary"
            app:boxBackgroundColor="@color/input_box_bg"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/spotify_green"
            app:counterEnabled="true"
            app:counterMaxLength="300"
            app:counterTextColor="@color/text_secondary"
            app:hintTextColor="@color/spotify_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlaylistDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="300"
                android:minLines="2"
                android:maxLines="3"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Public / Private Toggle Switch Card -->
        <LinearLayout
            android:id="@+id/layoutPublicToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_creator_readonly"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/ivPublicIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_globe"
                app:tint="@color/spotify_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPublicTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Công khai danh sách phát"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPublicDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mọi người dùng khác đều có thể tìm thấy và nghe playlist này."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchPublic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:useMaterialThemeColors="true" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="Hủy"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:cornerRadius="24dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.6">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreatePlaylistSubmit"
                    style="@style/Widget.Spotify.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Tạo playlist"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp" />

                <ProgressBar
                    android:id="@+id/pbLoading"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
