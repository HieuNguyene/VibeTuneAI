<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_24dp"
        android:paddingTop="@dimen/spacing_16dp"
        android:paddingEnd="@dimen/spacing_24dp"
        android:paddingBottom="@dimen/spacing_32dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnRegisterBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go Back"
            android:padding="@dimen/spacing_12dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <!-- Title & Subtitle -->
        <TextView
            android:id="@+id/tvRegisterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24dp"
            android:text="@string/register_title"
            android:textAppearance="@style/TextAppearance.Spotify.Headline"
            android:textSize="26sp"
            app:layout_constraintTop_toBottomOf="@id/btnRegisterBack" />

        <TextView
            android:id="@+id/tvRegisterSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/register_subtitle"
            android:textAppearance="@style/TextAppearance.Spotify.BodySecondary"
            app:layout_constraintTop_toBottomOf="@id/tvRegisterTitle" />

        <!-- Social Register: Google -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueGoogle"
            style="@style/Widget.Spotify.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/spacing_24dp"
            android:text="@string/continue_with_google"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconTint="@null"
            app:layout_constraintTop_toBottomOf="@id/tvRegisterSubtitle" />

        <!-- Divider with "HOẶC" -->
        <LinearLayout
            android:id="@+id/layoutDivider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/btnContinueGoogle">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_12dp"
                android:layout_marginEnd="@dimen/spacing_12dp"
                android:text="@string/or_divider"
                android:textAppearance="@style/TextAppearance.Spotify.Caption"
                android:textColor="@color/icon_inactive"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider_color" />
        </LinearLayout>

        <!-- Tab Toggle: Số điện thoại vs Email -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupRegType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16dp"
            app:checkedButton="@id/btnTabPhone"
            app:layout_constraintTop_toBottomOf="@id/layoutDivider"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabPhone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/tab_phone"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:strokeColor="@color/spotify_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabEmail"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/tab_email"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:strokeColor="@color/spotify_stroke" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Phone Section (Phone input + Send OTP + OTP input) -->
        <LinearLayout
            android:id="@+id/layoutPhoneSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16dp"
            android:orientation="vertical"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/toggleGroupRegType">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegPhone"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hint_phone"
                    android:textColorHint="@color/text_secondary"
                    app:boxBackgroundColor="@color/spotify_surface"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_radius_card"
                    app:boxCornerRadiusBottomStart="@dimen/corner_radius_card"
                    app:boxCornerRadiusTopEnd="@dimen/corner_radius_card"
                    app:boxCornerRadiusTopStart="@dimen/corner_radius_card"
                    app:boxStrokeColor="@color/spotify_green"
                    app:boxStrokeWidth="1dp"
                    app:hintTextColor="@color/spotify_green">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendOtp"
                    style="@style/Widget.Spotify.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_send_otp"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegOtp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12dp"
                android:hint="@string/hint_otp"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/spotify_surface"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_card"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_card"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_card"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_card"
                app:boxStrokeColor="@color/spotify_green"
                app:boxStrokeWidth="1dp"
                app:hintTextColor="@color/spotify_green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegOtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:letterSpacing="0.2"
                    android:maxLength="6"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvOtpTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textAppearance="@style/TextAppearance.Spotify.Caption"
                android:textColor="@color/spotify_green"
                android:visibility="gone"
                tools:text="Mã xác thực đã gửi. Gửi lại sau 58s"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Email Section -->
        <LinearLayout
            android:id="@+id/layoutEmailSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/toggleGroupRegType">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_email"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/spotify_surface"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_card"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_card"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_card"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_card"
                app:boxStrokeColor="@color/spotify_green"
                app:boxStrokeWidth="1dp"
                app:hintTextColor="@color/spotify_green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Display Name Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRegUsername"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12dp"
            android:hint="@string/hint_username"
            android:textColorHint="@color/text_secondary"
            app:boxBackgroundColor="@color/spotify_surface"
            app:boxCornerRadiusBottomEnd="@dimen/corner_radius_card"
            app:boxCornerRadiusBottomStart="@dimen/corner_radius_card"
            app:boxCornerRadiusTopEnd="@dimen/corner_radius_card"
            app:boxCornerRadiusTopStart="@dimen/corner_radius_card"
            app:boxStrokeColor="@color/spotify_green"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="@color/spotify_green"
            app:layout_constraintTop_toBottomOf="@id/barrierDynamicFields">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRegPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12dp"
            android:hint="@string/hint_password"
            android:textColorHint="@color/text_secondary"
            app:boxBackgroundColor="@color/spotify_surface"
            app:boxCornerRadiusBottomEnd="@dimen/corner_radius_card"
            app:boxCornerRadiusBottomStart="@dimen/corner_radius_card"
            app:boxCornerRadiusTopEnd="@dimen/corner_radius_card"
            app:boxCornerRadiusTopStart="@dimen/corner_radius_card"
            app:boxStrokeColor="@color/spotify_green"
            app:boxStrokeWidth="1dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/text_secondary"
            app:helperText="Ít nhất 6 ký tự"
            app:helperTextTextColor="@color/text_secondary"
            app:hintTextColor="@color/spotify_green"
            app:layout_constraintTop_toBottomOf="@id/tilRegUsername">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Barrier for Dynamic Form Sections -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierDynamicFields"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="layoutPhoneSection,layoutEmailSection" />

        <!-- Register Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            style="@style/Widget.Spotify.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/spacing_24dp"
            android:text="@string/btn_register"
            app:layout_constraintTop_toBottomOf="@id/tilRegPassword" />

        <!-- Login Prompt Footer -->
        <LinearLayout
            android:id="@+id/layoutLoginPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnRegister">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/have_account_prompt"
                android:textAppearance="@style/TextAppearance.Spotify.BodySecondary" />

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_now"
                android:textAppearance="@style/TextAppearance.Spotify.Body"
                android:textColor="@color/spotify_green"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
