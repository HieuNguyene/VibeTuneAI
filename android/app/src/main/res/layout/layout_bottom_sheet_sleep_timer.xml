<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_20dp"
    android:paddingTop="@dimen/spacing_16dp"
    android:paddingEnd="@dimen/spacing_20dp"
    android:paddingBottom="@dimen/spacing_24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_16dp"
        android:background="@drawable/bg_pill_indicator"
        android:backgroundTint="@color/text_disabled" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_timer"
            app:tint="@color/spotify_green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hẹn giờ tắt nhạc"
                android:textAppearance="@style/TextAppearance.Spotify.Headline"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSleepTimerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dừng phát nhạc tự động sau khoảng thời gian chọn"
                android:textAppearance="@style/TextAppearance.Spotify.Caption" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_16dp"
        android:layout_marginBottom="@dimen/spacing_8dp"
        android:background="@color/divider_color" />

    <!-- Timer Options -->
    <TextView
        android:id="@+id/btnTimer5Min"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="5 phút"
        android:textAppearance="@style/TextAppearance.Spotify.Body"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btnTimer15Min"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="15 phút"
        android:textAppearance="@style/TextAppearance.Spotify.Body"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btnTimer30Min"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="30 phút"
        android:textAppearance="@style/TextAppearance.Spotify.Body"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btnTimer45Min"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="45 phút"
        android:textAppearance="@style/TextAppearance.Spotify.Body"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btnTimer60Min"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="1 giờ"
        android:textAppearance="@style/TextAppearance.Spotify.Body"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btnTimerEndOfSong"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="Khi kết thúc bài hát này"
        android:textAppearance="@style/TextAppearance.Spotify.Body"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btnTimerTurnOff"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="Tắt tính năng hẹn giờ"
        android:textAppearance="@style/TextAppearance.Spotify.Body"
        android:textColor="@color/genre_rock"
        android:textSize="15sp"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
