<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="48dp"
    android:paddingBottom="6dp">

    <!-- AI Sparkle Avatar -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle_icon"
        android:backgroundTint="@color/chat_ai_avatar_bg"
        android:gravity="center">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="AI DJ"
            android:src="@drawable/ic_assistant_wave"
            app:tint="@color/spotify_green" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_chat_bubble_ai"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateTint="@color/spotify_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Đang tìm bài hát phù hợp..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="italic" />

    </LinearLayout>

</LinearLayout>
