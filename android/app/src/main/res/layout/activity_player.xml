<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player_gradient_placeholder">

    <!-- Gradient Background Overlay view for Palette transitions -->
    <View
        android:id="@+id/vGradientOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_gradient_placeholder" />

    <!-- Status Bar Spacer to push top bar completely below status bar and camera punch hole -->
    <View
        android:id="@+id/statusBarSpacerPlayer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TOP BAR (Sticky / Fixed at Top with explicit safe container) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPlayerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/statusBarSpacerPlayer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnCollapsePlayer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Collapse Player"
            android:padding="@dimen/spacing_12dp"
            android:src="@drawable/ic_chevron_down"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/icon_primary" />

        <LinearLayout
            android:id="@+id/layoutTopHeaderInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnPlayerMenu"
            app:layout_constraintStart_toEndOf="@id/btnCollapsePlayer"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvHeaderPlayingFrom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/playing_from_playlist"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderPlaylistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Spotify.Body"
                android:textStyle="bold"
                tools:text="Top Hits Việt Nam" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnPlayerMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/spacing_12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Options Menu"
            android:padding="@dimen/spacing_12dp"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/icon_primary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SCROLLABLE PLAYER CONTENT: MAIN CONTROLS + DEDICATED LYRICS SECTION BELOW -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPlayerContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:saveEnabled="false"
        app:layout_constraintTop_toBottomOf="@id/layoutPlayerTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="beforeDescendants"
            android:paddingBottom="180dp">

            <!-- MAIN PLAYER SECTION (Screen 1) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutMainPlayerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- ALBUM ART (Square 1:1 Aspect Ratio) -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPlayerAlbumArt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/spacing_24dp"
                    android:layout_marginTop="@dimen/spacing_16dp"
                    android:layout_marginEnd="@dimen/spacing_24dp"
                    android:elevation="12dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Spotify.AlbumArt"
                    tools:srcCompat="@android:drawable/ic_menu_gallery" />


                <!-- TRACK DETAILS & FAVORITE / DISLIKE BUTTONS -->
                <LinearLayout
                    android:id="@+id/layoutPlayerTrackInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_24dp"
                    android:layout_marginTop="@dimen/spacing_24dp"
                    android:layout_marginEnd="@dimen/spacing_12dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@id/layoutLikeDislike"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivPlayerAlbumArt">

                    <TextView
                        android:id="@+id/tvPlayerSongTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:fadingEdge="horizontal"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Spotify.Headline"
                        android:textSize="20sp"
                        tools:text="Chúng Ta Của Tương Lai" />

                    <TextView
                        android:id="@+id/tvPlayerArtistName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Spotify.BodySecondary"
                        android:textSize="15sp"
                        tools:text="Sơn Tùng M-TP" />

                    <!-- Mood Flow Reason Banner -->
                    <LinearLayout
                        android:id="@+id/layoutMoodFlowReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/ivMoodFlowReasonIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_assistant_wave"
                            app:tint="@color/spotify_green" />

                        <TextView
                            android:id="@+id/tvMoodFlowReason"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/spotify_green"
                            android:textSize="12sp"
                            android:textStyle="italic"
                            tools:text="Giai điệu dịu êm, giảm dần nhịp độ để bạn dễ dàng thư giãn" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutLikeDislike"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="@id/layoutPlayerTrackInfo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/layoutPlayerTrackInfo">

                    <ImageButton
                        android:id="@+id/btnPlayerDislike"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Dislike Track"
                        android:padding="8dp"
                        android:src="@drawable/ic_thumb_down"
                        app:tint="@color/text_secondary" />

                    <ImageButton
                        android:id="@+id/btnPlayerFavorite"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Like Track"
                        android:padding="8dp"
                        android:src="@drawable/ic_favorite_border"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- MOOD FLOW ARC SELECTOR PILL -->
                <LinearLayout
                    android:id="@+id/btnMoodFlowArcSelector"
                    style="@style/Widget.Spotify.Chip.Raised"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="@dimen/spacing_24dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill_inactive"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layoutPlayerTrackInfo">

                    <ImageView
                        android:id="@+id/ivMoodFlowDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_assistant_wave"
                        app:tint="@color/spotify_green" />

                    <TextView
                        android:id="@+id/tvMoodFlowArcName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Mood Flow • Ổn định"
                        android:textColor="@color/spotify_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- CUSTOM SEEKBAR & TIMESTAMPS -->
                <SeekBar
                    android:id="@+id/playerSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/seekbar_height"
                    android:layout_marginStart="@dimen/spacing_16dp"
                    android:layout_marginTop="@dimen/spacing_12dp"
                    android:layout_marginEnd="@dimen/spacing_16dp"
                    android:max="1000"
                    android:paddingStart="@dimen/spacing_8dp"
                    android:paddingEnd="@dimen/spacing_8dp"
                    android:progress="320"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/seekbar_thumb"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnMoodFlowArcSelector" />

                <TextView
                    android:id="@+id/tvCurrentTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_24dp"
                    android:text="@string/time_zero"
                    android:textAppearance="@style/TextAppearance.Spotify.Caption"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/playerSeekBar"
                    tools:text="1:12" />

                <TextView
                    android:id="@+id/tvTotalDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_24dp"
                    android:text="@string/time_zero"
                    android:textAppearance="@style/TextAppearance.Spotify.Caption"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/playerSeekBar"
                    tools:text="4:05" />

                <!-- PLAYBACK CONTROL BUTTONS (-10s / PlayPause / +30s + Speed Selector) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutPlaybackControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    app:layout_constraintTop_toBottomOf="@id/tvCurrentTimestamp">

                    <!-- Shuffle -->
                    <ImageButton
                        android:id="@+id/btnShuffle"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Phát ngẫu nhiên"
                        android:padding="7dp"
                        android:src="@drawable/ic_shuffle"
                        app:layout_constraintBottom_toBottomOf="@id/btnPlayPause"
                        app:layout_constraintEnd_toStartOf="@id/btnPrevious"
                        app:layout_constraintHorizontal_chainStyle="spread_inside"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/btnPlayPause"
                        app:tint="@color/text_secondary" />

                    <!-- Previous -->
                    <ImageButton
                        android:id="@+id/btnPrevious"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Bài trước"
                        android:padding="6dp"
                        android:src="@drawable/ic_skip_previous"
                        app:layout_constraintBottom_toBottomOf="@id/btnPlayPause"
                        app:layout_constraintEnd_toStartOf="@id/btnRewind10s"
                        app:layout_constraintStart_toEndOf="@id/btnShuffle"
                        app:layout_constraintTop_toTopOf="@id/btnPlayPause"
                        app:tint="@color/icon_primary" />

                    <!-- Rewind 10s (Left of Play/Pause) -->
                    <ImageButton
                        android:id="@+id/btnRewind10s"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Tua lùi 10 giây"
                        android:padding="7dp"
                        android:src="@drawable/ic_replay_10"
                        app:layout_constraintBottom_toBottomOf="@id/btnPlayPause"
                        app:layout_constraintEnd_toStartOf="@id/btnPlayPause"
                        app:layout_constraintStart_toEndOf="@id/btnPrevious"
                        app:layout_constraintTop_toTopOf="@id/btnPlayPause"
                        app:tint="@color/icon_primary" />

                    <!-- Play / Pause Main Floating Button -->
                    <ImageButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="@dimen/btn_play_pause_size"
                        android:layout_height="@dimen/btn_play_pause_size"
                        android:background="@drawable/bg_circle_white_play_button"
                        android:contentDescription="Phát hoặc tạm dừng"
                        android:elevation="6dp"
                        android:padding="@dimen/spacing_16dp"
                        android:src="@drawable/ic_play_arrow"
                        android:stateListAnimator="@animator/btn_tactile_raise"
                        app:layout_constraintEnd_toStartOf="@id/btnForward30s"
                        app:layout_constraintStart_toEndOf="@id/btnRewind10s"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/black" />

                    <!-- Forward 30s (Right of Play/Pause) -->
                    <ImageButton
                        android:id="@+id/btnForward30s"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Tua tới 30 giây"
                        android:padding="7dp"
                        android:src="@drawable/ic_forward_30"
                        app:layout_constraintBottom_toBottomOf="@id/btnPlayPause"
                        app:layout_constraintEnd_toStartOf="@id/btnNext"
                        app:layout_constraintStart_toEndOf="@id/btnPlayPause"
                        app:layout_constraintTop_toTopOf="@id/btnPlayPause"
                        app:tint="@color/icon_primary" />

                    <!-- Next -->
                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Bài tiếp theo"
                        android:padding="6dp"
                        android:src="@drawable/ic_skip_next"
                        app:layout_constraintBottom_toBottomOf="@id/btnPlayPause"
                        app:layout_constraintEnd_toStartOf="@id/btnRepeat"
                        app:layout_constraintStart_toEndOf="@id/btnForward30s"
                        app:layout_constraintTop_toTopOf="@id/btnPlayPause"
                        app:tint="@color/icon_primary" />

                    <!-- Repeat -->
                    <ImageButton
                        android:id="@+id/btnRepeat"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Lặp lại"
                        android:padding="7dp"
                        android:src="@drawable/ic_repeat"
                        app:layout_constraintBottom_toBottomOf="@id/btnPlayPause"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/btnNext"
                        app:layout_constraintTop_toTopOf="@id/btnPlayPause"
                        app:tint="@color/text_secondary" />

                    <!-- Playback Speed Selector Pill (matching Web Admin: 0.5x..2.0x, default 1.0x) -->
                    <LinearLayout
                        android:id="@+id/btnPlaybackSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_pill_inactive"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btnPlayPause">

                        <ImageView
                            android:id="@+id/ivPlaybackSpeedIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_speed"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvPlaybackSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Tốc độ 1.0x"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- BOTTOM ACCESSORY BAR (Devices & Queue + Lyrics Peek in Center) -->
                <ImageButton
                    android:id="@+id/btnDeviceConnect"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/spacing_24dp"
                    android:layout_marginTop="@dimen/spacing_16dp"
                    android:layout_marginBottom="@dimen/spacing_16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Connect Device"
                    android:padding="@dimen/spacing_8dp"
                    android:src="@drawable/ic_devices"
                    app:layout_constraintTop_toBottomOf="@id/layoutPlaybackControls"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tint="@color/text_secondary" />

                <!-- LYRICS PEEK / HINT BAR (Center between Devices and Queue) -->
                <LinearLayout
                    android:id="@+id/layoutLyricsPeek"
                    style="@style/Widget.Spotify.Chip.Raised"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_pill_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    app:layout_constraintTop_toTopOf="@id/btnDeviceConnect"
                    app:layout_constraintBottom_toBottomOf="@id/btnDeviceConnect"
                    app:layout_constraintStart_toEndOf="@id/btnDeviceConnect"
                    app:layout_constraintEnd_toStartOf="@id/btnQueueList">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lyrics"
                        app:tint="@color/spotify_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Lời bài hát ↓"
                        android:textColor="@color/liquid_text_inactive"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnQueueList"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/spacing_24dp"
                    android:layout_marginTop="@dimen/spacing_16dp"
                    android:layout_marginBottom="@dimen/spacing_16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Music Queue"
                    android:padding="@dimen/spacing_8dp"
                    android:src="@drawable/ic_queue_music"
                    app:layout_constraintTop_toBottomOf="@id/layoutPlaybackControls"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="@color/text_secondary" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- DEDICATED SPOTIFY LYRICS EXPANDED SECTION (Screen 2 - Visible when scrolling down) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLyricsScrollSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="560dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="@color/spotify_surface"
                app:cardCornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/spotify_stroke"
                android:elevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_lyrics"
                            app:tint="@color/spotify_green" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="LỜI BÀI HÁT"
                            android:textColor="@color/spotify_green"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tvLyricsStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:text="♪ Đang dạo nhạc..."
                            android:textColor="@color/spotify_green"
                            android:textSize="12sp"
                            android:textStyle="italic"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btnScrollBackToTop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="6dp"
                            android:text="Lên đầu ↑"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvLyricsScrollSection"
                        android:layout_width="match_parent"
                        android:layout_height="480dp"
                        android:nestedScrollingEnabled="true"
                        android:clipToPadding="false"
                        android:paddingTop="180dp"
                        android:paddingBottom="240dp"
                        android:layout_marginTop="16dp"
                        android:overScrollMode="never" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/divider_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lời bài hát được đồng bộ theo nhịp bài nhạc."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
