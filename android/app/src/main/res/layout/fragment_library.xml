<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black">

    <!-- Top Bar with Title and Add Button -->
    <LinearLayout
        android:id="@+id/layoutLibraryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16dp"
        android:layout_marginTop="@dimen/spacing_24dp"
        android:layout_marginEnd="@dimen/spacing_16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_library"
            android:textAppearance="@style/TextAppearance.Spotify.Headline" />

        <ImageButton
            android:id="@+id/btnCreatePlaylist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_icon"
            android:contentDescription="Create Playlist"
            android:elevation="5dp"
            android:padding="@dimen/spacing_8dp"
            android:src="@android:drawable/ic_input_add"
            android:stateListAnimator="@animator/btn_tactile_raise"
            app:tint="@color/icon_primary" />
    </LinearLayout>

    <!-- Library Filter Chips (Horizontal Scrollable) -->
    <HorizontalScrollView
        android:id="@+id/layoutLibraryChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/layoutLibraryHeader">

        <com.example.spotifyclone.ui.liquid.LiquidPillRow
            android:id="@+id/pillRowLibrary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_16dp"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/spacing_16dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/chipPlaylists"
                style="@style/Widget.Spotify.Chip.Raised"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/spacing_8dp"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_16dp"
                android:paddingEnd="@dimen/spacing_16dp"
                android:text="Playlist"
                android:textColor="@color/liquid_text_inactive"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipArtists"
                style="@style/Widget.Spotify.Chip.Raised"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/spacing_8dp"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_16dp"
                android:paddingEnd="@dimen/spacing_16dp"
                android:text="Nghệ sĩ"
                android:textColor="@color/liquid_text_inactive"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipAlbums"
                style="@style/Widget.Spotify.Chip.Raised"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/spacing_8dp"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_16dp"
                android:paddingEnd="@dimen/spacing_16dp"
                android:text="Album"
                android:textColor="@color/liquid_text_inactive"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipSongs"
                style="@style/Widget.Spotify.Chip.Raised"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_16dp"
                android:paddingEnd="@dimen/spacing_16dp"
                android:text="Âm nhạc"
                android:textColor="@color/liquid_text_inactive"
                android:textSize="12sp" />
        </com.example.spotifyclone.ui.liquid.LiquidPillRow>
    </HorizontalScrollView>

    <!-- Playlist Sub-selection Filter (Selection Button Group: Tất cả, Playlist cá nhân, Playlist yêu thích) -->
    <HorizontalScrollView
        android:id="@+id/layoutPlaylistSubFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/layoutLibraryChips">

        <LinearLayout
            android:id="@+id/segmentedPlaylistSubGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16dp"
            android:layout_marginEnd="@dimen/spacing_16dp"
            android:background="@drawable/bg_selection_button_group"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/chipSubAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_16dp"
                android:paddingEnd="@dimen/spacing_16dp"
                android:text="Tất cả"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_selection_button_active"
                android:textColor="@color/selection_active_text"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipSubPersonal"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_16dp"
                android:paddingEnd="@dimen/spacing_16dp"
                android:text="Playlist cá nhân"
                android:textSize="12sp"
                android:background="@drawable/bg_selection_button_inactive"
                android:textColor="@color/selection_inactive_text"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipSubFavorite"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_16dp"
                android:paddingEnd="@dimen/spacing_16dp"
                android:text="Playlist yêu thích"
                android:textSize="12sp"
                android:background="@drawable/bg_selection_button_inactive"
                android:textColor="@color/selection_inactive_text"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Shimmer Skeleton Loading State -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLibraryContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutPlaylistSubFilters"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="@color/shimmer_base"
        app:shimmer_highlight_color="@color/shimmer_highlight">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/item_shimmer_row" />
            <include layout="@layout/item_shimmer_row" />
            <include layout="@layout/item_shimmer_row" />
            <include layout="@layout/item_shimmer_row" />
            <include layout="@layout/item_shimmer_row" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- RecyclerView of Saved Items / Playlists -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLibraryItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_12dp"
        android:clipToPadding="false"
        android:paddingBottom="144dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutPlaylistSubFilters"
        tools:listitem="@layout/item_song_list_row" />

    <!-- EMPTY STATE PATTERN -->
    <LinearLayout
        android:id="@+id/layoutLibraryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutPlaylistSubFilters">

        <ImageView
            android:id="@+id/ivLibraryEmptyIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_library"
            app:tint="@color/icon_inactive" />

        <TextView
            android:id="@+id/tvLibraryEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16dp"
            android:text="@string/empty_library_title"
            android:textAppearance="@style/TextAppearance.Spotify.Title" />

        <TextView
            android:id="@+id/tvLibraryEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8dp"
            android:gravity="center"
            android:text="@string/empty_library_subtitle"
            android:textAppearance="@style/TextAppearance.Spotify.BodySecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExploreMusic"
            style="@style/Widget.Spotify.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20dp"
            android:text="Khám phá ngay" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
