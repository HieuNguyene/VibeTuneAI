<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_16dp"
    android:paddingEnd="@dimen/spacing_16dp">

    <!-- Square Thumbnail Skeleton -->
    <View
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_shimmer_placeholder" />

    <!-- Two Title & Subtitle Skeleton Bars -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_12dp"
        android:layout_marginEnd="@dimen/spacing_16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="160dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_shimmer_placeholder" />

        <View
            android:layout_width="90dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_shimmer_placeholder" />
    </LinearLayout>

    <!-- Placeholder Action Circles -->
    <View
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="@dimen/spacing_12dp"
        android:background="@drawable/bg_shimmer_placeholder" />

    <View
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:background="@drawable/bg_shimmer_placeholder" />

</LinearLayout>
