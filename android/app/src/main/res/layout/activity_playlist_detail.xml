<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:background="@color/spotify_black">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/spotify_black"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:statusBarScrim="@color/spotify_black"
            app:titleEnabled="false">

            <!-- Parallax Header Container with Gradient & Info -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutPlaylistHeaderParallax"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_player_gradient_placeholder"
                app:layout_collapseMode="parallax">

                <!-- Playlist Big Cover Art -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPlaylistCover"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="56dp"
                    android:elevation="2dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Spotify.Card"
                    tools:srcCompat="@android:drawable/ic_menu_gallery" />

                <!-- Playlist Title -->
                <TextView
                    android:id="@+id/tvPlaylistTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_20dp"
                    android:layout_marginTop="@dimen/spacing_16dp"
                    android:layout_marginEnd="@dimen/spacing_20dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Spotify.Headline"
                    app:layout_constraintTop_toBottomOf="@id/ivPlaylistCover"
                    tools:text="Top Hits Việt Nam" />

                <!-- Subtitle / Creator Details -->
                <TextView
                    android:id="@+id/tvPlaylistDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Spotify.Caption"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPlaylistTitle"
                    tools:text="Tạo bởi VibeTune • 50 bài hát, khoảng 3 giờ" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Sticky Toolbar when Collapsed -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarDetail"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:elevation="10dp"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_chevron_down">

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Spotify.Title"
                    tools:text="Top Hits Việt Nam" />
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Playlist Song List & Actions -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPlaylistContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="152dp">

            <!-- Action Bar: Like Playlist, Download, More, Shuffle / Play -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_16dp"
                android:paddingTop="@dimen/spacing_12dp"
                android:paddingEnd="@dimen/spacing_16dp"
                android:paddingBottom="@dimen/spacing_12dp">

                <ImageButton
                    android:id="@+id/btnPlaylistFavorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Like Playlist"
                    android:padding="@dimen/spacing_8dp"
                    android:src="@drawable/ic_favorite_border"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/btnPlaylistMore"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/spacing_12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More Options"
                    android:padding="@dimen/spacing_8dp"
                    android:src="@drawable/ic_more_vert"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnPlaylistFavorite"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/text_secondary" />

                <!-- Floating Round Spotify Green Play CTA -->
                <ImageButton
                    android:id="@+id/btnPlaylistPlayAll"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_play_button"
                    android:contentDescription="Play All"
                    android:elevation="8dp"
                    android:padding="@dimen/spacing_16dp"
                    android:src="@drawable/ic_play_arrow"
                    android:stateListAnimator="@animator/btn_tactile_raise"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/on_primary_accent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Shimmer Skeleton Loading State -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerPlaylistContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:shimmer_auto_start="true"
                app:shimmer_base_color="@color/shimmer_base"
                app:shimmer_highlight_color="@color/shimmer_highlight">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/item_shimmer_row" />
                    <include layout="@layout/item_shimmer_row" />
                    <include layout="@layout/item_shimmer_row" />
                    <include layout="@layout/item_shimmer_row" />
                    <include layout="@layout/item_shimmer_row" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutPlaylistEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_32dp"
                android:paddingTop="48dp"
                android:paddingEnd="@dimen/spacing_32dp"
                android:paddingBottom="48dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_playlist_add"
                    app:tint="@color/icon_inactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16dp"
                    android:text="Chưa có bài hát nào"
                    android:textAppearance="@style/TextAppearance.Spotify.Headline"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8dp"
                    android:gravity="center"
                    android:text="Hãy khám phá và thêm các bài hát yêu thích vào danh sách phát này."
                    android:textAppearance="@style/TextAppearance.Spotify.BodySecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExploreTracks"
                    style="@style/Widget.Spotify.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_20dp"
                    android:text="Khám phá ngay" />
            </LinearLayout>

            <!-- Song List in Playlist -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlaylistTracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="10"
                tools:listitem="@layout/item_song_list_row" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Translucent Liquid-Glass Bottom Section (MiniPlayer + 3D Water-Droplet NavBar) -->
    <LinearLayout
        android:id="@+id/bottomNavigationContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp">

        <com.example.spotifyclone.ui.liquid.LiquidGlassMiniPlayerFrame
            android:id="@+id/miniPlayerGlassFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <include
                android:id="@+id/includedMiniPlayer"
                layout="@layout/layout_mini_player" />
        </com.example.spotifyclone.ui.liquid.LiquidGlassMiniPlayerFrame>

        <com.example.spotifyclone.ui.liquid.LiquidDropletNavBar
            android:id="@+id/liquidNavBar"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginBottom="10dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
