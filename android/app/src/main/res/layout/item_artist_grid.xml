<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="228dp"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/btn_tactile_raise"
    app:cardBackgroundColor="@color/spotify_elevated"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/spotify_stroke"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Full-bleed Artist Image (to, tràn viền, không lồng khung) -->
        <ImageView
            android:id="@+id/ivArtistAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Ảnh nghệ sĩ"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_person" />

        <!-- Gradient Scrim for crisp readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_artist_poster_scrim" />

        <!-- Artist Info floating at bottom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <!-- Artist Name & Verified Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvArtistName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:shadowRadius="3"
                    android:textColor="@color/white"
                    android:textSize="15.5sp"
                    android:textStyle="bold"
                    tools:text="Sơn Tùng M-TP" />

                <ImageView
                    android:id="@+id/badgeVerified"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="Nghệ sĩ đã xác minh"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone"
                    app:tint="@color/spotify_green"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Subtitle (Song count & Followers) -->
            <TextView
                android:id="@+id/tvArtistSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                tools:text="7 bài hát • 5.4M" />

            <!-- Following Tag -->
            <TextView
                android:id="@+id/tvArtistFollowTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_badge_following_glass"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Đang theo dõi"
                android:textColor="@color/spotify_green"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
