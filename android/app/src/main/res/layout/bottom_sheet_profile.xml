<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/spotify_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_20dp"
    android:paddingTop="@dimen/spacing_12dp"
    android:paddingEnd="@dimen/spacing_20dp"
    android:paddingBottom="@dimen/spacing_32dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_16dp"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="@color/spotify_stroke" />

    <!-- User Header Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivUserAvatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@color/spotify_elevated"
            android:padding="12dp"
            android:src="@drawable/ic_person"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Spotify.Pill"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguyễn Minh Hiếu"
                android:textAppearance="@style/TextAppearance.Spotify.Title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="minhhieu@spotify.com"
                android:textAppearance="@style/TextAppearance.Spotify.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_active"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="PREMIUM"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_20dp"
        android:layout_marginBottom="@dimen/spacing_12dp"
        android:background="@color/divider_color" />

    <!-- Menu Item: Account Settings -->
    <LinearLayout
        android:id="@+id/btnAccountSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_8dp"
        android:paddingEnd="@dimen/spacing_8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_person"
            app:tint="@color/text_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16dp"
            android:layout_weight="1"
            android:text="@string/account_settings"
            android:textAppearance="@style/TextAppearance.Spotify.Body" />
    </LinearLayout>

    <!-- Menu Item: Audio Quality -->
    <LinearLayout
        android:id="@+id/btnAudioQuality"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_8dp"
        android:paddingEnd="@dimen/spacing_8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_devices"
            app:tint="@color/text_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16dp"
            android:layout_weight="1"
            android:text="@string/audio_quality"
            android:textAppearance="@style/TextAppearance.Spotify.Body" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_12dp"
        android:layout_marginBottom="@dimen/spacing_20dp"
        android:background="@color/divider_color" />

    <!-- Big Logout Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProfileLogout"
        style="@style/Widget.Spotify.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:strokeColor="@color/error_red"
        android:text="@string/btn_logout"
        android:textColor="@color/error_red"
        app:icon="@drawable/ic_logout"
        app:iconGravity="textStart"
        app:iconTint="@color/error_red" />

</LinearLayout>
