<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="136dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="4dp"
    android:stateListAnimator="@animator/btn_tactile_raise">

    <FrameLayout
        android:layout_width="124dp"
        android:layout_height="124dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivArtistAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Spotify.Circle"
            app:strokeWidth="0dp" />

        <FrameLayout
            android:id="@+id/badgeVerified"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="2dp"
            android:background="@drawable/bg_verified_badge_wrap"
            android:padding="3dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Nghệ sĩ đã xác minh"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/spotify_green" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvArtistName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="Nghệ sĩ"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvArtistSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Nghệ sĩ"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>
