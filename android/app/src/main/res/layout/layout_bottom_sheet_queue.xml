<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_24dp">

    <!-- BottomSheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_12dp"
        android:layout_marginBottom="@dimen/spacing_12dp"
        android:background="@drawable/bg_pill_indicator"
        android:backgroundTint="@color/text_disabled" />

    <!-- Queue Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_20dp"
        android:paddingEnd="@dimen/spacing_20dp"
        android:paddingBottom="@dimen/spacing_12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Danh sách phát tiếp theo"
            android:textAppearance="@style/TextAppearance.Spotify.Headline"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQueueTrackCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Spotify.Caption"
            android:textColor="@color/spotify_green"
            tools:text="5 bài hát" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/spacing_8dp"
        android:background="@color/divider_color" />

    <!-- Queue Tracks RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQueueTracks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:maxHeight="420dp"
        android:overScrollMode="never" />

</LinearLayout>
