<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black">

    <!-- Screen Title -->
    <TextView
        android:id="@+id/tvSearchHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16dp"
        android:layout_marginTop="@dimen/spacing_24dp"
        android:text="@string/nav_search"
        android:textAppearance="@style/TextAppearance.Spotify.Headline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3D Liquid-Glass Search Bar Pill -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvSearchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/spacing_16dp"
        android:layout_marginTop="@dimen/spacing_16dp"
        android:layout_marginEnd="@dimen/spacing_16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvSearchHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_btn_3d_dropdown"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search Icon"
                android:src="@drawable/ic_search"
                app:tint="@color/icon_primary" />

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/spacing_8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear text"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:visibility="gone"
                app:tint="@color/icon_primary" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- DEFAULT STATE: Browse Categories Section -->
    <TextView
        android:id="@+id/tvBrowseAllHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16dp"
        android:layout_marginTop="@dimen/spacing_24dp"
        android:layout_marginEnd="@dimen/spacing_16dp"
        android:text="@string/search_categories_title"
        android:textAppearance="@style/TextAppearance.Spotify.Title"
        app:layout_constraintTop_toBottomOf="@id/cvSearchBar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBrowseCategories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/spacing_12dp"
        android:layout_marginTop="@dimen/spacing_12dp"
        android:layout_marginEnd="@dimen/spacing_12dp"
        android:clipToPadding="false"
        android:paddingBottom="144dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBrowseAllHeader"
        app:spanCount="2"
        tools:listitem="@layout/item_genre_card" />

    <!-- Shimmer Skeleton Loading State -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvSearchBar"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="@color/shimmer_base"
        app:shimmer_highlight_color="@color/shimmer_highlight">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/item_shimmer_row" />
            <include layout="@layout/item_shimmer_row" />
            <include layout="@layout/item_shimmer_row" />
            <include layout="@layout/item_shimmer_row" />
            <include layout="@layout/item_shimmer_row" />
            <include layout="@layout/item_shimmer_row" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- SEARCH RESULT STATE: Live Song Results List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_12dp"
        android:clipToPadding="false"
        android:paddingBottom="144dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvSearchBar"
        tools:listitem="@layout/item_song_list_row" />

    <!-- EMPTY SEARCH STATE -->
    <LinearLayout
        android:id="@+id/layoutSearchEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_32dp"
        android:paddingTop="64dp"
        android:paddingEnd="@dimen/spacing_32dp"
        android:paddingBottom="64dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvSearchBar">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_search"
            app:tint="@color/icon_inactive" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16dp"
            android:text="Không tìm thấy kết quả"
            android:textAppearance="@style/TextAppearance.Spotify.Headline"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8dp"
            android:gravity="center"
            android:text="Vui lòng kiểm tra lại chính tả bài hát hoặc nghệ sĩ bạn muốn tìm."
            android:textAppearance="@style/TextAppearance.Spotify.BodySecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearSearchAction"
            style="@style/Widget.Spotify.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20dp"
            android:text="Xóa tìm kiếm" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
