<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_16dp"
        android:paddingEnd="@dimen/spacing_16dp"
        android:paddingBottom="@dimen/spacing_48dp">

        <!-- AI Header with Sparkle Icon -->
        <LinearLayout
            android:id="@+id/layoutAiTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="@dimen/spacing_8dp"
                android:src="@drawable/ic_sparkle_ai"
                app:tint="@color/spotify_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Music Assistant"
                android:textAppearance="@style/TextAppearance.Spotify.Headline" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAiSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tạo danh sách phát cá nhân hóa theo tâm trạng và sở thích nhờ sức mạnh của Gemini AI."
            android:textAppearance="@style/TextAppearance.Spotify.BodySecondary"
            app:layout_constraintTop_toBottomOf="@id/layoutAiTitle" />

        <!-- AI Prompt Input Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvPromptInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20dp"
            app:cardBackgroundColor="@color/spotify_elevated"
            app:cardCornerRadius="@dimen/corner_radius_card"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvAiSubtitle"
            app:strokeColor="@color/spotify_stroke"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/etAiPrompt"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/ai_prompt_hint"
                android:padding="@dimen/spacing_16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/icon_inactive"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Suggested Mood Chips -->
        <TextView
            android:id="@+id/tvQuickSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16dp"
            android:text="Gợi ý nhanh:"
            android:textAppearance="@style/TextAppearance.Spotify.Caption"
            app:layout_constraintTop_toBottomOf="@id/cvPromptInput" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMoods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8dp"
            app:layout_constraintTop_toBottomOf="@id/tvQuickSuggestions"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRain"
                style="@style/Widget.Spotify.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☕ Chill mưa rơi" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGym"
                style="@style/Widget.Spotify.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Tập gym bùng nổ" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFocus"
                style="@style/Widget.Spotify.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Deep focus code" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAcoustic"
                style="@style/Widget.Spotify.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌙 Acoustic đêm khuya" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip90s"
                style="@style/Widget.Spotify.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📻 V-Pop hoài niệm" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Primary CTA Generate Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerateAiPlaylist"
            style="@style/Widget.Spotify.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/spacing_24dp"
            android:text="@string/ai_generate_button"
            app:icon="@drawable/ic_sparkle_ai"
            app:iconGravity="textStart"
            app:iconTint="@color/black"
            app:layout_constraintTop_toBottomOf="@id/chipGroupMoods" />

        <!-- AI Multi-Step Loading Indicator (Explainable AI) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAiLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/spotify_elevated"
            app:cardCornerRadius="@dimen/corner_radius_card"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/btnGenerateAiPlaylist">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_20dp">

                <ProgressBar
                    android:id="@+id/progressAiLoading"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminateTint="@color/spotify_green" />

                <TextView
                    android:id="@+id/tvAiStatusStep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12dp"
                    android:text="@string/ai_generating_step_1"
                    android:textAppearance="@style/TextAppearance.Spotify.Body"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mô hình Gemini đang tổng hợp phân tích ngữ nghĩa..."
                    android:textAppearance="@style/TextAppearance.Spotify.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AI Generated Result Preview Section -->
        <LinearLayout
            android:id="@+id/layoutAiResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/cardAiLoading">

            <TextView
                android:id="@+id/tvGeneratedPlaylistTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Playlist: Chiều Mưa Cà Phê"
                android:textAppearance="@style/TextAppearance.Spotify.Title" />

            <TextView
                android:id="@+id/tvAiReasoningExplanation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="✨ Tuyển tập các giai điệu Indie Acoustic nhẹ nhàng phù hợp tiết trời se lạnh."
                android:textAppearance="@style/TextAppearance.Spotify.Caption"
                android:textColor="@color/spotify_green_light" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAiGeneratedSongs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="5"
                tools:listitem="@layout/item_song_list_row" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
