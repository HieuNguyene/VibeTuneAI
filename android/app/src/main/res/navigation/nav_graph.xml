<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.spotifyclone.presentation.home.HomeFragment"
        android:label="Trang chủ"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_search"
        android:name="com.example.spotifyclone.presentation.search.SearchFragment"
        android:label="Tìm kiếm"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/navigation_library"
        android:name="com.example.spotifyclone.presentation.playlist.LibraryFragment"
        android:label="Thư viện"
        tools:layout="@layout/fragment_library" />

    <fragment
        android:id="@+id/navigation_ai"
        android:name="com.example.spotifyclone.presentation.ai.AiChatFragment"
        android:label="AI Assistant"
        tools:layout="@layout/fragment_ai_chat" />

</navigation>
