<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#DE181A20"
                android:centerColor="#E3121317"
                android:endColor="#EB090A0D" />
            <stroke android:width="1.2dp" android:color="#66E2E8F0" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="12dp" android:right="12dp" android:top="2dp" android:bottom="44dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
