<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1.5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#48FFFFFF"
                        android:endColor="#2E0E0F13" />
                    <stroke android:width="1.2dp" android:color="#A6E2E8F0" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="2.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#40000000" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#3AFFFFFF"
                        android:centerColor="#22FFFFFF"
                        android:endColor="#2E090A0D" />
                    <stroke android:width="1.15dp" android:color="#78E2E8F0" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item android:left="10dp" android:right="10dp" android:top="2dp" android:bottom="18dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#66FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
