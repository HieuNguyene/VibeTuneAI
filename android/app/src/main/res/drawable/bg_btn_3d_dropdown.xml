<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1.5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#F2FFFFFF"
                        android:endColor="#E2EEFA" />
                    <stroke android:width="1.2dp" android:color="#CC0EA5E9" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="2.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1F0C243D" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#F7FFFFFF"
                        android:centerColor="#F0F7FE"
                        android:endColor="#E4EFFA" />
                    <stroke android:width="1.15dp" android:color="#BDD4EB" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item android:left="10dp" android:right="10dp" android:top="2dp" android:bottom="18dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#66FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
