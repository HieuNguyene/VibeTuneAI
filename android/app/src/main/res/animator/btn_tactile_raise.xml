<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed: soft liquid compression into the screen like a water droplet under finger pressure -->
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="85"
                android:valueTo="-2dp"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationY"
                android:duration="85"
                android:valueTo="1.5dp"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="95"
                android:valueTo="0.955"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="95"
                android:valueTo="0.925"
                android:valueType="floatType" />
        </set>
    </item>

    <!-- Rest: elastic spring overshoot back into proud 3D water-droplet buoyancy -->
    <item>
        <set>
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="240"
                android:interpolator="@android:interpolator/overshoot"
                android:valueTo="5dp"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationY"
                android:duration="240"
                android:interpolator="@android:interpolator/overshoot"
                android:valueTo="0dp"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="260"
                android:interpolator="@android:interpolator/overshoot"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="260"
                android:interpolator="@android:interpolator/overshoot"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
