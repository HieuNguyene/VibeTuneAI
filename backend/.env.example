# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Local or MongoDB Atlas)
# Ví dụ Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/music_app?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/music_app

# Security & Authentication (JWT)
JWT_SECRET=production_secret_key_spotify_clone_auth_token_2026
JWT_EXPIRES_IN=7d

# Google Gemini API (AI Playlist & Recommendation Engine)
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
