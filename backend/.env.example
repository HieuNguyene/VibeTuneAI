# ===================================================================
# VibeTune Music Streaming Backend - Environment Configuration
# ===================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/music_app
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/music_app?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/music_app

# Security & Authentication (JWT)
JWT_SECRET=production_secret_key_vibetune_auth_token_2026
JWT_EXPIRES_IN=7d

# Google Gemini API & AI Models
# Lấy API Key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Music Metadata Enrichment (Optional: Last.fm)
LASTFM_API_KEY=

# Google OAuth 2.0 Client ID(s) để xác thực Google ID Token (phân tách bằng dấu phẩy)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Tài khoản Quản trị Web Admin (/admin, /api/v1/admin/*)
ADMIN_EMAIL=admin@vibetune.local
ADMIN_PASSWORD=change_this_strong_admin_password
# Đặt true nếu muốn tự động đồng bộ ADMIN_PASSWORD vào database khi khởi động server
ADMIN_SYNC_PASSWORD=false

# Phone OTP Service (Tùy chọn: SMS OTP Provider)
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# eSMS.vn (Provider Việt Nam)
ESMS_API_KEY=
ESMS_SECRET_KEY=
